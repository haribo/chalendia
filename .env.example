# Copy to `.env` at the repository root — `just dev-setup` does it for you.
#
# This file configures **local development**. A deployed shop gets its values
# from its environment (see docker-compose.yaml), never from here.
#
# Required variables have no default: the application refuses to start without
# them, naming the one at fault.

# --- Local development ports ---
# Deliberately not 5432 / 8080 / 5173: a developer runs several projects on one
# machine. Change any that clash on yours, and the rest of this file with them.

CHALENDIA_DEV_DB_PORT=5442
CHALENDIA_DEV_API_PORT=8090
CHALENDIA_DEV_WEB_PORT=5183

# --- Backend ---

# Required. Public address the shop answers on. Emails, canonical URLs and
# payment redirections are built from it, so it cannot be guessed.
CHALENDIA_PUBLIC_URL=http://localhost:5183

# Address the API listens on. Default: 127.0.0.1:8080
CHALENDIA_BIND=127.0.0.1:8090

# Comma-separated browser origins allowed to call the API.
# Default: CHALENDIA_PUBLIC_URL alone. A wildcard is refused.
CHALENDIA_CORS_ORIGINS=http://localhost:5183

# Required. PostgreSQL connection URL. Unprefixed on purpose: it is the name
# container images, hosted database providers and the sqlx tooling all use.
# The port must match CHALENDIA_DEV_DB_PORT above.
DATABASE_URL=postgres://chalendia:chalendia@127.0.0.1:5442/chalendia

# Connection pool ceiling. Default: 5 — one shop on a modest server gains
# nothing from a large pool and costs the database for each connection.
CHALENDIA_DATABASE_MAX_CONNECTIONS=5

# Where the built frontend lives. Set by the container image; leave unset in
# development, where the Vite dev server serves the application itself.
# CHALENDIA_STATIC_DIR=/srv/chalendia/static

# Where uploaded product photographs are written. Relative to the working
# directory. Set by the container image to a mounted volume; the default is fine
# in development. Back this up: nothing here can be recomputed from the database.
# CHALENDIA_MEDIA_DIR=media

# Log filter. Default: info
RUST_LOG=info

# --- Compose ---
# Read by docker-compose.yaml, not by the application.

POSTGRES_USER=chalendia
POSTGRES_PASSWORD=chalendia
POSTGRES_DB=chalendia

# Host port the shop is published on when run as an operator would. Default: 8080
CHALENDIA_PORT=8080
