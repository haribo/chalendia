{
  "name": "chalendia-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && npm run check:gallery-absent",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . && npm run lint:tokens && npm run lint:type",
    "lint:tokens": "node scripts/check-theme-tokens.mjs",
    "lint:type": "node scripts/check-text-styles.mjs",
    "check:gallery-absent": "node scripts/check-gallery-absent.mjs",
    "test": "vitest run",
    "codegen:api": "openapi-typescript ../backend/api/openapi.json -o src/shared/api/generated/openapi.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
