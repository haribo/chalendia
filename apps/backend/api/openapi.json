{
  "openapi": "3.1.0",
  "info": {
    "title": "Chalendia",
    "description": "HTTP API of a self-hosted shop. Published with each release so anyone can write another client.",
    "license": {
      "name": "AGPL-3.0-only",
      "url": "https://www.gnu.org/licenses/agpl-3.0.html"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report whether the shop is serving and whether it can reach its database.",
        "description": "A running shop that cannot reach its database is a distinct situation from a\nstopped one, and an operator's supervision has to tell them apart. The status\ncode follows the aggregate — a degraded instance answers 503 so a proxy stops\nrouting to it — while the body says which part failed.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The shop is serving and its database answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The shop is serving but its database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Serve this API's own contract.",
        "description": "A third party writing a client reads it from the running instance rather\nthan from the repository, so it always describes the version answering.",
        "operationId": "openapi_document",
        "responses": {
          "200": {
            "description": "The OpenAPI document describing this API"
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "List the products, most recently created first.",
        "description": "Staff only: this shows drafts and retired products, which is precisely what\nthe storefront must never do.",
        "operationId": "list_products",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "One-based. Anything lower is read as the first page.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Bounded by the shop, not by the caller.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "catalogue"
        ],
        "summary": "Create a product and the single variant carrying its price.",
        "operationId": "create_product",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewProduct"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The product was created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "A field was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}/images": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "summary": "Every image of one product, in the order they are shown.",
        "operationId": "list_images",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The product",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The product's images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductImage"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "catalogue"
        ],
        "summary": "Add one photograph to a product.",
        "description": "Multipart, with a `file` part carrying the JPEG and an optional\n`alternativeText` part. The answer comes back before the sizes the shop\nserves are derived, and says so: the image is `pending`\n(`docs/backend/adr/0008-image-pipeline.md`).",
        "operationId": "add_image",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The product",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Stored, and being prepared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductImage"
                }
              }
            }
          },
          "400": {
            "description": "type: /problems/malformed-upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "type: /problems/no-such-product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "413": {
            "description": "type: /problems/image-too-heavy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "type: /problems/image-not-jpeg, /problems/image-too-small, /problems/image-too-large, /problems/too-many-images, /problems/image-missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}/images/order": {
      "put": {
        "tags": [
          "catalogue"
        ],
        "summary": "Put a product's images in a given order.",
        "operationId": "reorder_images",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The product",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WantedOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The images, in their new order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductImage"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "type: /problems/no-such-product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "type: /problems/not-the-same-images — one missing, extra, repeated, or belonging to another product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}/images/{imageId}": {
      "delete": {
        "tags": [
          "catalogue"
        ],
        "summary": "Remove one image, and the files it was stored as.",
        "operationId": "remove_image",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The product",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "imageId",
            "in": "path",
            "description": "The image",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "type: /problems/no-such-image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions": {
      "post": {
        "tags": [
          "staff"
        ],
        "summary": "Sign in.",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopState"
                }
              }
            }
          },
          "401": {
            "description": "The address and password do not match",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "staff"
        ],
        "summary": "Sign out, ending this session everywhere it was usable.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "The session is over, whether or not there was one"
          }
        }
      }
    },
    "/api/setup": {
      "post": {
        "tags": [
          "shop"
        ],
        "summary": "Configure the shop and create its first administrator.",
        "description": "Runs once. Once a shop is configured this is refused by the shop itself, not\nmerely hidden by the interface (`docs/design/core.md` § 3).",
        "operationId": "run_setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The shop is configured and the administrator is signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopState"
                }
              }
            }
          },
          "409": {
            "description": "This shop is already configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "A field is missing or the password is too short",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/shop": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Report whether this installation has been set up.",
        "description": "Public and unauthenticated on purpose: the interface has to know whether to\nshow the setup screen before anyone can possibly be signed in. It exposes\nthe shop's public identity and nothing else.",
        "operationId": "read_shop",
        "responses": {
          "200": {
            "description": "The shop's public state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShopState"
                }
              }
            }
          }
        }
      }
    },
    "/api/staff/me": {
      "get": {
        "tags": [
          "staff"
        ],
        "summary": "Report who the caller is signed in as.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in staff member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffIdentity"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vat-rates": {
      "get": {
        "tags": [
          "tax"
        ],
        "summary": "List the rates the shop charges.",
        "description": "Readable by any staff member: the product form has to offer them.",
        "operationId": "list_rates",
        "responses": {
          "200": {
            "description": "The rates, highest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VatRate"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tax"
        ],
        "summary": "Add a rate.",
        "operationId": "create_rate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewVatRate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The rates, the new one among them",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VatRate"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Reserved to an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "A field was refused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vat-rates/{id}": {
      "delete": {
        "tags": [
          "tax"
        ],
        "summary": "Remove a rate, unless products carry it.",
        "operationId": "remove_rate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The rate to remove",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "It is gone"
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Reserved to an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such rate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Products carry it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vat-rates/{id}/default": {
      "put": {
        "tags": [
          "tax"
        ],
        "summary": "Make a rate the shop default.",
        "operationId": "make_default",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The rate to make default",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rates, with the default moved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VatRate"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Reserved to an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No such rate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "dependents": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "How many rows depend on what the caller tried to remove.\n\nA number rather than a sentence: the shop cannot know the reader's\nlanguage, and \"1 products\" is what happens when a server writes prose\n(`docs/design/core.md` § 8, Errors — user-visible errors are localized)."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "invalid-params": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/InvalidParam"
            },
            "description": "Every field refused, not merely the first one met: a caller correcting\none field at a time is a caller submitting five times."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Machine-readable identifier of the problem kind. `about:blank` means the\nstatus code alone describes it."
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Dependency": {
        "type": "string",
        "enum": [
          "up",
          "unreachable"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "database"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/Dependency"
          },
          "service": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          }
        }
      },
      "ImageState": {
        "type": "string",
        "description": "How far a derived size has got.",
        "enum": [
          "pending",
          "ready",
          "failed"
        ]
      },
      "InvalidParam": {
        "type": "object",
        "description": "One refused field, in the shape RFC 9457 reserves for exactly this.\n\n`reason` is present only when it says something the submitted value does not\nalready show: \"already taken\" yes, \"this address is malformed\" no — the\nclient can see that.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "NewProduct": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "merchantReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Inclusive of tax, in minor units of the shop currency\n(`docs/design/core.md` § 5, § 6).\n\nOptional in the contract and required by the shop: an amount nobody can\nread is absent as far as an interface is concerned, and refusing it here\nis what lets every other refusal come back in the same answer."
          },
          "state": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProductState",
                "description": "Draft unless staff publish from the same form. Absent means draft."
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "vatRateId": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Absent means the shop default applies (`docs/design/core.md` § 6)."
          }
        }
      },
      "NewVatRate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "basisPoints": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "isDefault": {
            "type": "boolean",
            "description": "Absent means the first rate is the default and the others are not."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ProductImage": {
        "type": "object",
        "description": "One image, as the back office reads it.",
        "required": [
          "id",
          "reference",
          "position",
          "state",
          "width",
          "height"
        ],
        "properties": {
