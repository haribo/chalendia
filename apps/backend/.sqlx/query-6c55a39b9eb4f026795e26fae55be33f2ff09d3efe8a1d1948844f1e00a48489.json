{
  "db_name": "PostgreSQL",
  "query": "select p.id, p.title, p.slug, p.state, v.price, v.merchant_reference\n         from products p\n         join lateral (\n             select price, merchant_reference\n             from variants\n             where product_id = p.id\n             order by id\n             limit 1\n         ) v on true\n         order by p.created_at desc, p.id desc\n         limit $1 offset $2",
